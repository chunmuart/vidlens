# API试运行配置片段：将相同名称的配置合并到 backend/.env，保留已有数据库等配置。
# 本文件不会自动加载，也不要用它覆盖整份 backend/.env。
# 配置指南：docs/Agent优化与API配置.md

# Agent：DeepSeek官方平台。已有可用AI配置时可保留原值。
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_THINKING_MODE=disabled
AI_REQUEST_TIMEOUT_SECONDS=180

# 百炼北京地域：ASR与OCR可共用同一业务空间的Key。
# 若控制台为新业务空间提供专属域名，请将下面两个地址改成该空间API示例中的地址。
DASHSCOPE_API_KEY=
ASR_PROVIDER=dashscope
ASR_BASE_URL=https://dashscope.aliyuncs.com
ASR_MODEL=fun-asr
ASR_API_KEY=
ASR_REQUEST_TIMEOUT_SECONDS=60
ASR_POLL_TIMEOUT_SECONDS=600
ASR_POLL_INTERVAL_SECONDS=2
ASR_LOCAL_FALLBACK_ENABLED=false
LOCAL_ASR_ENABLED=false
LOCAL_ASR_PRELOAD=false

OCR_ENABLED=true
OCR_PROVIDER=dashscope
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_API_KEY=
OCR_MODEL=qwen3.5-ocr
OCR_REQUEST_TIMEOUT_SECONDS=60
OCR_MAX_TOKENS=4096
OCR_INTERVAL_SECONDS=15
PADDLEOCR_MAX_FRAMES=12
EVIDENCE_PARALLEL_ENABLED=true

# 初次试运行上限：按同一任务的累计模型请求计数；不包含ASR/OCR收费。
AGENT_MAX_ROUNDS=12
AGENT_MAX_ESTIMATED_TOKENS=60000
AGENT_MAX_DURATION_MS=180000
AGENT_MAX_ESTIMATED_COST=0
AI_INPUT_COST_PER_MILLION_TOKENS=0
AI_OUTPUT_COST_PER_MILLION_TOKENS=0
AI_CACHE_HIT_INPUT_COST_PER_MILLION_TOKENS=0
CHECKPOINT_ENABLED=1
